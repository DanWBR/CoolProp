<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>CoolProp.Net</AssemblyName>
    <RootNamespace>CoolProp</RootNamespace>

    <!-- Required by the LibraryImport source generator, which emits code in
         unsafe blocks for the marshalling stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Implies IsTrimmable, EnableTrimAnalyzer, EnableAotAnalyzer and
         EnableSingleFileAnalyzer. Combined with TreatWarningsAsErrors from
         Directory.Build.props, an AOT-hostile construct fails this build
         instead of failing at a consumer's `dotnet publish`. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CoolProp.Net</PackageId>
    <Description>.NET 10 bindings for the CoolProp thermophysical property library, with native binaries for six desktop runtimes.</Description>
    <Authors>CoolProp developers</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DanWBR/CoolProp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DanWBR/CoolProp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>coolprop;thermodynamics;thermophysical;refprop;fluid-properties</PackageTags>
  </PropertyGroup>

  <Import Project="..\pack.targets" />

</Project>
